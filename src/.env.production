# ============ PRODUCTION CONFIGURATION ============
# Copy this file to .env and fill in your actual values.
# NEVER commit secrets to version control.

# Database
DATABASE_URL=postgresql://connext_user:YOUR_DB_PASSWORD@connext-db.postgres.database.azure.com:5432/connextdb

# JWT
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_string_here

# CORS origins (comma-separated)
CORS_ORIGINS=https://connextfront.kindmoss-4634ec14.germanywestcentral.azurecontainerapps.io

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace_with_another_random_64_char_secret

# File uploads
UPLOAD_PROVIDER=local
# For Azure Blob Storage:
# UPLOAD_PROVIDER=azure_blob
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=connext-uploads
# For AWS S3:
# UPLOAD_PROVIDER=s3
# AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
# AWS_S3_BUCKET=connext-uploads
# AWS_REGION=eu-west-1

# Redis (optional, for rate limiting + caching)
# In docker-compose: use the service name "redis"
# In Azure Container Apps: use your Azure Cache for Redis hostname
REDIS_URL=redis://redis:6379/0

# Geocoding
GEOCOPY_USER_AGENT=ConnextApp/1.0 (your.email@example.com)