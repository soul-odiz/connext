# ============ PRODUCTION CONFIGURATION ============
# Copy this file to .env and fill in your actual values.
# NEVER commit secrets to version control.
# Run this to generate secure keys:
#   python -c "import secrets; print('JWT_SECRET_KEY:', secrets.token_hex(64)); print('SECRET_KEY:', secrets.token_hex(64))"

# Database (Azure PostgreSQL Flexible Server)
# Get connection string after: az postgres flexible-server show --resource-group connext-rg --name connext-db
DATABASE_URL=postgresql://connext_admin:YOUR_DB_PASSWORD@connext-db.postgres.database.azure.com:5432/connextdb

# JWT
JWT_SECRET_KEY=replace_with_secure_random_64_char_hex_here
JWT_EXPIRY_HOURS=24

# Flask session
SECRET_KEY=replace_with_another_secure_random_64_char_hex_here

# Flask
FLASK_ENV=production
FLASK_DEBUG=0

# CORS origins (comma-separated)
# Replace with your actual frontend FQDN after deployment
CORS_ORIGINS=https://connext-frontend.kindmoss-4634ec14.germanywestcentral.azurecontainerapps.io

# File uploads
UPLOAD_PROVIDER=azure_blob
MAX_UPLOAD_SIZE_MB=10
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=connextstorage;AccountKey=YOUR_STORAGE_ACCOUNT_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=connext-uploads

# Alternative: AWS S3 (uncomment and configure if using AWS instead)
# UPLOAD_PROVIDER=s3
# AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
# AWS_S3_BUCKET=connext-uploads
# AWS_REGION=eu-west-1

# Redis for rate limiting (Azure Cache for Redis)
# Azure Redis requires SSL on port 6380. Format: rediss://:PASSWORD@HOSTNAME:6380/0
# Get password from: az redis list-keys --resource-group connext-rg --name connext-redis --query primaryKey -o tsv
# Get hostname from: az redis show --resource-group connext-rg --name connext-redis --query hostName -o tsv
REDIS_URL=rediss://:YOUR_REDIS_PRIMARY_KEY@connext-redis.redis.cache.windows.net:6380/0

# Redis SSL options for flask-limiter (needed for Azure Redis on port 6380)
# Note: flask-limiter 3.5.0 + redis 5.0.1 may need ssl_cert_reqs appended:
# REDIS_URL=rediss://:PASSWORD@HOST:6380/0?ssl_cert_reqs=CERT_NONE

# Rate Limiting
RATE_LIMIT_DEFAULT=200 per day, 50 per hour
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_LOGIN=20 per hour
RATE_LIMIT_UPLOAD=10 per hour
RATE_LIMIT_MESSAGE=60 per minute

# Database pool
DB_POOL_SIZE=10
DB_POOL_RECYCLE=300
DB_MAX_OVERFLOW=20

# Geocoding
GEOCOPY_USER_AGENT=ConnextApp/1.0 (your.email@example.com)

# Sentry error monitoring (optional - set DSN to enable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# SocketIO
SOCKETIO_ASYNC_MODE=eventlet
REQUIRE_SOCKET_AUTH=true
ENGINEIO_DEBUG=false

# Logging
LOG_LEVEL=INFO